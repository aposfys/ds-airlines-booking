# ══════════════════════════════════════════════════════════
#  DS Airlines — environment configuration
#  Copy to `.env` and fill in. Never commit the filled copy.
# ══════════════════════════════════════════════════════════

# ── Security ──────────────────────────────────────────────
# REQUIRED. The application refuses to start without this.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ──────────────────────────────────────────────
# Phase 0 runs on MongoDB; Phase 1 migrates to PostgreSQL (see docs/adr/).
MONGO_URL=mongodb://localhost:27017
DB_NAME=dsairlines

# ── Seeding ───────────────────────────────────────────────
# Demo data is opt-in and must never be enabled in production.
SEED_ON_STARTUP=false

# Bootstrap administrator. Only used when SEED_ON_STARTUP=true.
# There is no default password: seeding is skipped unless both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
