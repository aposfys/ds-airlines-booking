# ══════════════════════════════════════════════════════════
#  DS Airlines — environment configuration
#  Copy to `.env` and fill in. Never commit the filled copy.
# ══════════════════════════════════════════════════════════

# ── Security ──────────────────────────────────────────────
# REQUIRED. The application refuses to start without this.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ──────────────────────────────────────────────
# PostgreSQL from Phase 1 — docs/adr/0001-postgresql-over-mongodb.md
# REQUIRED for docker compose.
POSTGRES_PASSWORD=
POSTGRES_USER=dsairlines
POSTGRES_DB=dsairlines

# Used when running the backend outside Docker. Inside compose this is built
# from the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://dsairlines:dsairlines@localhost:5432/dsairlines

# Target for the test suite. It is dropped and re-migrated on every run, so
# never point this at a database you care about.
TEST_DATABASE_URL=postgresql+asyncpg://dsairlines:dsairlines@localhost:5432/dsairlines_test

# Log every statement, including parameter values — which for this schema
# means passenger names. Local debugging only.
SQL_ECHO=false

# ── Seeding ───────────────────────────────────────────────
# Reference data (airports, aircraft, routes, fare classes) is always seeded
# when missing; the application cannot sell anything without it.
# Demo flights and the administrator are gated behind this flag.
SEED_ON_STARTUP=false

# Bootstrap administrator. Only used when SEED_ON_STARTUP=true.
# There is no default password: seeding is skipped unless both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── API ───────────────────────────────────────────────────
# Comma-separated allowed origins. Leave empty for the localhost-only dev
# default; set it explicitly for any real deployment.
CORS_ORIGINS=

# ── Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
